# Optional: free abuse.ch Auth-Key for current URLhaus/MalwareBazaar APIs.
# Obtain it from the abuse.ch Authentication Portal, then copy this file to
# .env (which is ignored by git) and set the value locally.
ABUSECH_AUTH_KEY=

# FAST web dashboard binds to localhost by default. Keep localhost when using
# Tailscale Funnel; `./bin/fast-share` proxies the service securely.
FAST_WEB_BIND=127.0.0.1

# Wazuh Dashboard is published only on localhost to avoid colliding with
# Tailscale Funnel on host port 443. Override this local port only if needed.
FAST_WAZUH_DASHBOARD_LOCAL_PORT=5601

# Optional explicit Wazuh Dashboard URL used by the FAST UI button.
# Leave empty to let FAST derive the correct local or Tailscale URL.
FAST_WAZUH_DASHBOARD_URL=

# Optional UI metadata overrides. Normally these can stay unset; when the UI
# is opened through a *.ts.net Funnel hostname FAST derives them automatically.
FAST_PUBLIC_URL=
FAST_DEPLOYMENT_MODE=local
FAST_DB_PATH=
