# Optional: free abuse.ch Auth-Key for current URLhaus/MalwareBazaar APIs.
# Obtain it from the abuse.ch Authentication Portal, then copy this file to
# .env (which is ignored by git) and set the value locally.
ABUSECH_AUTH_KEY=

# FAST web dashboard binds to localhost by default. Keep localhost when using
# ./bin/fast-share because Tailscale proxies to the local service.
FAST_WEB_BIND=127.0.0.1

# Optional external Wazuh Dashboard address used by the FAST UI button.
# With ./bin/fast-share the button can use the same *.ts.net hostname on 8443.
FAST_WAZUH_DASHBOARD_URL=
FAST_WAZUH_DASHBOARD_LOCAL_PORT=5601

# Live Wazuh data used by Detection Validation, Incidents, Detection Health and
# Architecture > Asset Catalog. Defaults match the Wazuh single-node demo.
# If you change Wazuh credentials, mirror the new values in your local .env.
FAST_WAZUH_API_URL=https://wazuh.manager:55000
FAST_WAZUH_API_USER=wazuh-wui
FAST_WAZUH_API_PASSWORD=MyS3cr37P450r.*-
FAST_WAZUH_INDEXER_URL=https://wazuh.indexer:9200
FAST_WAZUH_INDEXER_USER=admin
FAST_WAZUH_INDEXER_PASSWORD=SecretPassword
FAST_WAZUH_VERIFY_TLS=0
FAST_WAZUH_TIMEOUT=8
WAZUH_DOCKER_NETWORK=single-node_default

# Security-operations state. Wazuh remains the source of truth for telemetry;
# this SQLite file stores only analyst workflow metadata + the FAST audit log.
FAST_OPS_DB_PATH=fast_operations.db
FAST_VALIDATION_FRESH_MINUTES=30

# Optional FAST authentication / RBAC. Disabled by default to preserve existing
# local deployments. Before exposing a real deployment, enable auth and set a
# strong session secret + admin password. Roles: viewer, analyst, admin.
FAST_AUTH_ENABLED=0
FAST_SESSION_SECRET=
FAST_SESSION_HOURS=8
FAST_SESSION_COOKIE_SECURE=0
FAST_ADMIN_USER=admin
FAST_ADMIN_PASSWORD=
# Optional additional users. Password values may be plaintext environment
# secrets or Werkzeug pbkdf2:/scrypt: hashes. Example:
# FAST_USERS_JSON={"analyst":{"password":"change-me","role":"analyst"},"viewer":{"password":"change-me","role":"viewer"}}
FAST_USERS_JSON=

# Optional public deployment metadata.
FAST_PUBLIC_URL=
FAST_DEPLOYMENT_MODE=local
FAST_DB_PATH=
