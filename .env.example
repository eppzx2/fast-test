# Optional: free abuse.ch Auth-Key for current URLhaus/MalwareBazaar APIs.
# Obtain it from the abuse.ch Authentication Portal, then copy this file to
# .env (which is ignored by git) and set the value locally.
ABUSECH_AUTH_KEY=

# FAST web dashboard binds to localhost by default. Set this only when you
# intentionally want to expose port 5000 on another interface, e.g. Tailscale.
FAST_WEB_BIND=127.0.0.1

# Optional external Wazuh Dashboard address used by the FAST UI button.
# With ./bin/fast-share the button can use the same *.ts.net hostname on 8443.
FAST_WAZUH_DASHBOARD_URL=
FAST_WAZUH_DASHBOARD_LOCAL_PORT=5601

# Live Wazuh data used by Attack Simulation and Architecture > Asset Catalog.
# Defaults below match the official Wazuh Docker single-node demo credentials.
# If you change Wazuh credentials, mirror the new values in your local .env.
FAST_WAZUH_API_URL=https://wazuh.manager:55000
FAST_WAZUH_API_USER=wazuh-wui
FAST_WAZUH_API_PASSWORD=MyS3cr37P450r.*-
FAST_WAZUH_INDEXER_URL=https://wazuh.indexer:9200
FAST_WAZUH_INDEXER_USER=admin
FAST_WAZUH_INDEXER_PASSWORD=SecretPassword
FAST_WAZUH_VERIFY_TLS=0
FAST_WAZUH_TIMEOUT=8
WAZUH_DOCKER_NETWORK=single-node_default

# Optional public deployment metadata.
FAST_PUBLIC_URL=
FAST_DEPLOYMENT_MODE=local
FAST_DB_PATH=
