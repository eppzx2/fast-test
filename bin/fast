#!/bin/bash
# ============================================================
# FAST - Unified Operations CLI
# ============================================================
#
# A single management entrypoint for the FAST stack, conceptually
# similar to `systemctl`:
#
#   ./bin/fast up        deploy/start FAST (delegates to deploy.sh)
#   ./bin/fast down      stop FAST, preserve all persistent data
#   ./bin/fast restart   down + up (data preserved)
#   ./bin/fast status    show Wazuh + IOC Collector health
#
# DESIGN NOTES (read before modifying):
#   - This script does NOT reimplement Wazuh deployment. `up` calls
#     the project's existing ./deploy.sh, which already performs
#     prerequisite checks, Wazuh deployment, the first IOC collection
#     run, and health verification. deploy.sh is treated as the
#     single source of truth for "how FAST is deployed."
#   - Container names (single-node-wazuh.manager-1, etc.) and the
#     Wazuh health definition mirror deploy.sh. CRITICAL log checks are
#     scoped to the CURRENT container start so errors from an earlier
#     `docker restart` cannot poison the current status forever.
#   - Wazuh health includes the alert-delivery path: Filebeat must be
#     able to establish its TLS connection to the Indexer. Containers
#     being merely "running" is not sufficient for FAST HEALTHY.
#   - `down` intentionally never runs `docker compose down -v` (which
#     would delete named volumes / persistent data). Only a plain
#     `docker compose down` is used, exactly as already documented in
#     docs/DEPLOYMENT_GUIDE.md's "Stopping / Removing" section.
#   - IOC Collector has no long-running container by design (it's
#     invoked with `docker run --rm` for each collection cycle by
#     deploy.sh / refresh_iocs.sh). `status` therefore reports it in
#     terms of what actually exists: the Docker image, the SQLite
#     database, IOC count, and the most recent IOC timestamp - not a
#     fabricated "process" status.
#
# USAGE: ./bin/fast <up|down|restart|status> [options]
#   ./bin/fast up [--ip <IP>] [--reset-certs]   options are forwarded to deploy.sh
#   ./bin/fast --help
# ============================================================

set -Eeuo pipefail

PROJECT_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
WAZUH_COMPOSE_DIR="$PROJECT_ROOT/wazuh-docker/single-node"
MANAGER_CONTAINER="single-node-wazuh.manager-1"
INDEXER_CONTAINER="single-node-wazuh.indexer-1"
DASHBOARD_CONTAINER="single-node-wazuh.dashboard-1"
IOC_IMAGE="osint-ioc-collector"
IOC_WEB_CONTAINER="fast-ioc-collector-web"
FAST_COMPOSE_FILE="$PROJECT_ROOT/docker/docker-compose.fast.yml"
DB_FILE="$PROJECT_ROOT/ioc_database.db"

# Note: no global ERR trap here. status/up/restart intentionally
# return non-zero exit codes (2/3/4) to reflect system state - a
# blanket ERR trap would misreport those as script failures. Every
# real failure path below prints its own "[FAST] ERROR: ..." message
# and exits explicitly instead.

# ------------------------------------------------------------
# Low-level helpers
# ------------------------------------------------------------

docker_available() {
    command -v docker >/dev/null 2>&1
}

docker_daemon_up() {
    docker_available && docker info >/dev/null 2>&1
}

require_docker() {
    if ! docker_available; then
        echo "[FAST] ERROR: Docker is not installed. See: https://docs.docker.com/engine/install/" >&2
        exit 1
    fi
    if ! docker_daemon_up; then
        echo "[FAST] ERROR: Docker is installed but the daemon is not running (or not accessible)." >&2
        exit 1
    fi
}

# Prints one of: running | exited | not_found | docker_unavailable
container_state() {
    local name="$1"
    if ! docker_daemon_up; then
        echo "docker_unavailable"
        return
    fi
    local state
    if state=$(docker inspect -f '{{.State.Status}}' "$name" 2>/dev/null); then
        echo "$state"
    else
        echo "not_found"
    fi
}

manager_started_at() {
    docker inspect -f '{{.State.StartedAt}}' "$MANAGER_CONTAINER" 2>/dev/null || true
}

manager_current_critical_count() {
    local started_at
    started_at=$(manager_started_at)

    if [ -z "$started_at" ] || [ "$started_at" = "0001-01-01T00:00:00Z" ]; then
        echo "1"
        return
    fi

    docker logs --since "$started_at" "$MANAGER_CONTAINER" 2>&1 | grep -c "CRITICAL" || true
}

manager_current_errors() {
    local started_at
    started_at=$(manager_started_at)
    if [ -n "$started_at" ] && [ "$started_at" != "0001-01-01T00:00:00Z" ]; then
        docker logs --since "$started_at" "$MANAGER_CONTAINER" 2>&1 | grep -iE "CRITICAL|ERROR" | tail -20 || true
    fi
}

# Mirrors deploy.sh's wait_for_manager_healthy() health definition,
# but as a single one-shot check (no retry loop) for status reporting.
manager_process_health() {
    if [ "$(container_state "$MANAGER_CONTAINER")" != "running" ]; then
        echo "unreachable"
        return
    fi

    local critical_errors proc_count
    critical_errors=$(manager_current_critical_count)
    proc_count=$(docker exec "$MANAGER_CONTAINER" ps aux 2>/dev/null | grep -cE "wazuh-authd|wazuh-analysisd|wazuh-remoted" || true)

    if [ "$critical_errors" -eq 0 ] && [ "$proc_count" -ge 3 ]; then
        echo "healthy"
    else
        echo "unhealthy"
    fi
}

# Threat Hunting depends on Filebeat successfully publishing Manager alerts to
# the Indexer. This catches TLS/CA mismatches that otherwise leave all three
# Wazuh containers in a misleading "running" state.
filebeat_indexer_health() {
    if [ "$(container_state "$MANAGER_CONTAINER")" != "running" ] \
       || [ "$(container_state "$INDEXER_CONTAINER")" != "running" ]; then
        echo "unreachable"
        return
    fi

    if docker exec "$MANAGER_CONTAINER" \
        /usr/share/filebeat/bin/filebeat test output -e \
        -c /etc/filebeat/filebeat.yml >/dev/null 2>&1; then
        echo "healthy"
    else
        echo "unhealthy"
    fi
}

# Reuses core/db.py directly (no duplicated DB logic) to report real
# IOC counts and the most recent IOC timestamp.
ioc_db_summary() {
    if ! command -v python3 >/dev/null 2>&1; then
        echo "N/A|N/A"
        return
    fi
    python3 - "$PROJECT_ROOT" "$DB_FILE" <<'PYEOF' 2>/dev/null || echo "N/A|N/A"
import sys
project_root, db_file = sys.argv[1], sys.argv[2]
sys.path.insert(0, project_root)
from core import db
db.DB_PATH = db_file
try:
    count = db.get_count()
    rows = db.get_all_iocs()
    last_seen = rows[0]["last_seen"] if rows else "N/A"
    print(f"{count}|{last_seen}")
except Exception:
    print("N/A|N/A")
PYEOF
}

# ------------------------------------------------------------
# Commands
# ------------------------------------------------------------

cmd_up() {
    require_docker
    echo "[FAST] Starting FAST..."
    echo ""
    echo "[1/2] Deploying Wazuh + IOC Collector (running deploy.sh)..."
    echo "------------------------------------------------------------"
    if ( cd "$PROJECT_ROOT" && ./deploy.sh "$@" ); then
        echo "------------------------------------------------------------"
        echo "[OK] deploy.sh completed"
    else
        echo "------------------------------------------------------------"
        echo "[FAIL] deploy.sh exited with an error. FAST is NOT fully up." >&2
        exit 1
    fi

    echo ""
    echo "[1b/2] Starting the FAST web app container (persistent, health-checked)..."
    if (cd "$PROJECT_ROOT" && docker compose -f "$FAST_COMPOSE_FILE" up -d --build) >/dev/null; then
        echo "[OK] FAST web app container started (http://localhost:5000)"
    else
        echo "[WARN] FAST web app container failed to start (non-fatal, Wazuh is unaffected)" >&2
    fi

    echo ""
    echo "[2/2] Verifying services..."
    echo ""
    local status_rc=0
    cmd_status || status_rc=$?

    echo ""
    if [ "$status_rc" -eq 0 ]; then
        echo "FAST is UP."
    else
        echo "[WARN] Deployment finished but FAST is not fully healthy yet (status exit code: $status_rc)." >&2
        echo "Run './bin/fast status' again shortly, or check container logs." >&2
    fi
    return "$status_rc"
}

cmd_down() {
    require_docker
    local start_ts=$(date +%s)
    echo "[FAST] Stopping FAST..."
    echo ""

    local ioc_running
    ioc_running=$(docker ps --filter "ancestor=$IOC_IMAGE" --format '{{.ID}}' 2>/dev/null || true)
    if [ -n "$ioc_running" ]; then
        # shellcheck disable=SC2086
        docker stop $ioc_running >/dev/null
        echo "[OK] IOC Collector stopped"
    else
        echo "[OK] IOC Collector was not running (it only runs on-demand, no persistent process)"
    fi

    if [ -f "$PROJECT_ROOT/docker/docker-compose.fast.yml" ] && docker compose -f "$PROJECT_ROOT/docker/docker-compose.fast.yml" ps -q 2>/dev/null | grep -q .; then
        (cd "$PROJECT_ROOT" && docker compose -f docker/docker-compose.fast.yml down)
        echo "[OK] FAST web app container stopped"
    fi

    if [ -d "$WAZUH_COMPOSE_DIR" ]; then
        (cd "$WAZUH_COMPOSE_DIR" && docker compose down)
        echo "[OK] Wazuh stopped"
    else
        echo "[--] Wazuh has not been deployed yet (nothing to stop)"
    fi

    local elapsed=$(( $(date +%s) - start_ts ))
    echo ""
    echo "Persistent data preserved (named Docker volumes are not touched;"
    echo "'docker compose down' is used WITHOUT -v)."
    echo ""
    echo "FAST is DOWN. (teardown took ${elapsed}s)"
    if [ "$elapsed" -gt 30 ]; then
        echo "[WARN] Teardown exceeded the 30s target (${elapsed}s)." >&2
    fi
}

cmd_restart() {
    echo "[FAST] Restarting FAST..."
    echo ""
    cmd_down
    echo ""
    local up_rc=0
    cmd_up "$@" || up_rc=$?
    echo ""
    if [ "$up_rc" -eq 0 ]; then
        echo "FAST restart completed."
    else
        echo "[WARN] FAST restart finished but health check reported issues (exit code: $up_rc)." >&2
    fi
    return "$up_rc"
}

cmd_demo() {
    echo "[FAST] Starting FAST in DEMO mode (offline, fixture-seeded IOCs)..."
    local up_rc=0
    cmd_up --demo "$@" || up_rc=$?
    return "$up_rc"
}

cmd_status() {
    echo "FAST STATUS"
    echo "================================="
    echo ""

    local fb_health="unreachable"

    if ! docker_daemon_up; then
        if ! docker_available; then
            echo "Docker:              NOT INSTALLED"
        else
            echo "Docker:              INSTALLED but daemon not running/accessible"
        fi
        echo "Wazuh Manager        [ UNKNOWN ] (Docker unavailable)"
        echo "Wazuh Indexer        [ UNKNOWN ] (Docker unavailable)"
        echo "Wazuh Dashboard      [ UNKNOWN ] (Docker unavailable)"
    else
        local m_state i_state d_state m_health
        m_state=$(container_state "$MANAGER_CONTAINER")
        i_state=$(container_state "$INDEXER_CONTAINER")
        d_state=$(container_state "$DASHBOARD_CONTAINER")

        print_component() {
            local label="$1" state="$2"
            case "$state" in
                running)   printf "%-20s [ UP ]\n" "$label" ;;
                exited)    printf "%-20s [ DOWN ]\n" "$label" ;;
                not_found) printf "%-20s [ NOT DEPLOYED ]\n" "$label" ;;
                *)         printf "%-20s [ UNKNOWN ]\n" "$label" ;;
            esac
        }
        print_component "Wazuh Manager" "$m_state"
        print_component "Wazuh Indexer" "$i_state"
        print_component "Wazuh Dashboard" "$d_state"

        echo ""
        echo "Docker:"
        printf "  %-20s %s\n" "$MANAGER_CONTAINER" "$m_state"
        printf "  %-20s %s\n" "$INDEXER_CONTAINER" "$i_state"
        printf "  %-20s %s\n" "$DASHBOARD_CONTAINER" "$d_state"

        if [ "$m_state" = "running" ]; then
            m_health=$(manager_process_health)
            echo ""
            echo "Wazuh Manager health (current start only): $m_health"
            if [ "$m_health" = "unhealthy" ]; then
                echo "Current-start Manager errors:"
                manager_current_errors | sed 's/^/  /'
            fi
        else
            m_health="unreachable"
        fi

        fb_health=$(filebeat_indexer_health)
        echo "Filebeat -> Indexer alert pipeline: $fb_health"
        if [ "$fb_health" = "unhealthy" ]; then
            echo "  Alert indexing is broken; Threat Hunting may show no results."
            echo "  Run './bin/fast up --reset-certs' if the error is TLS/CA related."
        fi
    fi

    echo ""
    echo "IOC Collector:"
    if docker_daemon_up && docker image inspect "$IOC_IMAGE" >/dev/null 2>&1; then
        echo "  Docker image:        built"
    elif docker_daemon_up; then
        echo "  Docker image:        NOT BUILT (run './bin/fast up' first)"
    else
        echo "  Docker image:        UNKNOWN (Docker unavailable)"
    fi

    if docker_daemon_up; then
        local web_health
        web_health=$(docker inspect -f '{{.State.Health.Status}}' "$IOC_WEB_CONTAINER" 2>/dev/null || echo "not_running")
        echo "  Web app container:   $web_health (http://localhost:5000)"
    fi

    if [ -f "$DB_FILE" ]; then
        local summary count last_seen
        summary=$(ioc_db_summary)
        count="${summary%%|*}"
        last_seen="${summary##*|}"
        echo "  Database:            present ($DB_FILE)"
        echo "  IOCs collected:      $count"
        echo "  Most recent IOC:     $last_seen"
    else
        echo "  Database:            NOT INITIALIZED (no IOC collection has run yet)"
        echo "  IOCs collected:      N/A"
    fi

    echo ""
    echo "Overall:"
    if ! docker_daemon_up; then
        echo "  FAST                 [ UNKNOWN ] (Docker unavailable)"
        return 2
    elif [ "$(container_state "$MANAGER_CONTAINER")" = "not_found" ]; then
        echo "  FAST                 [ NOT DEPLOYED ]"
        return 4
    elif [ "${m_health:-unreachable}" = "healthy" ] \
         && [ "$fb_health" = "healthy" ] \
         && [ "$(container_state "$INDEXER_CONTAINER")" = "running" ] \
         && [ "$(container_state "$DASHBOARD_CONTAINER")" = "running" ]; then
        echo "  FAST                 [ HEALTHY ]"
        return 0
    else
        echo "  FAST                 [ DEGRADED ]"
        return 3
    fi
}

print_help() {
    cat <<'EOF'
FAST - Unified Operations CLI

Usage:
  ./bin/fast <command>

Commands:
  up          Deploy/start FAST (fetches live IOC feeds)
  demo        Deploy/start FAST in offline DEMO mode (fixture-seeded
              IOCs, no external network calls)
  down        Stop FAST and preserve data
  restart     Restart FAST
  status      Show FAST and service status

Options forwarded to deploy.sh for up/restart:
  --ip <IP>       Manager IP to display/use for agent setup
  --reset-certs   Force a clean Wazuh TLS certificate regeneration

General options:
  -h, --help      Show this help message

Exit codes (status, and up/restart which end with a status check):
  0  HEALTHY        3  DEGRADED
  2  Docker unavailable
  4  NOT DEPLOYED

Examples:
  ./bin/fast up
  ./bin/fast up --ip 100.87.195.65
  ./bin/fast up --reset-certs
  ./bin/fast demo
  ./bin/fast status
  ./bin/fast down
  ./bin/fast restart
EOF
}

main() {
    local cmd="${1:-}"

    case "$cmd" in
        ""|-h|--help)
            print_help
            exit 0
            ;;
        up)
            shift
            cmd_up "$@"
            ;;
        demo)
            shift
            cmd_demo "$@"
            ;;
        down)
            shift
            cmd_down "$@"
            ;;
        restart)
            shift
            cmd_restart "$@"
            ;;
        status)
            shift
            cmd_status "$@"
            ;;
        *)
            echo "[FAST] ERROR: Unknown command '$cmd'" >&2
            echo "" >&2
            print_help >&2
            exit 1
            ;;
    esac
}

main "$@"
