<!--
  Custom rules - TALON IOC Collector integration.
  These rules work with the /var/ossec/etc/lists/ioc-ips CDB list
  generated by core/wazuh_export.py.
  Format: each line is in the form "IP:1" (Wazuh CDB list requirement).
-->
<group name="local,osint_ioc,">
  <!-- Declare the CDB list for lookup -->
  <rule id="100100" level="0">
    <list field="srcip" lookup="address_match_key" check_value="1">etc/lists/ioc-ips</list>
    <description>TALON IOC list check (silent base rule)</description>
  </rule>
  <!-- Real alert: if srcip is found in the IOC list during known firewall/network events -->
  <rule id="100101" level="12">
    <if_sid>100100</if_sid>
    <description>ALERT: A known bad IP from the TALON IOC Collector was detected in a network event (srcip: $(srcip))</description>
    <mitre>
      <id>T1071</id>
    </mitre>
    <group>osint_ioc_match,</group>
  </rule>
  <!-- Same check for SSH/authentication events -->
  <rule id="100102" level="12">
    <if_group>authentication_failed</if_group>
    <list field="srcip" lookup="address_match_key" check_value="1">etc/lists/ioc-ips</list>
    <description>ALERT: Authentication attempt from a known bad IP (TALON IOC match, srcip: $(srcip))</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>osint_ioc_match,authentication_failed,</group>
  </rule>
</group>

<!--
  Custom rules - Attack simulation detections (SSH brute force, port
  scan, LOLBin masquerading). See docs/runbook.md for rule IDs,
  expected alerts, prerequisites, and how to run the simulation
  scripts under tests/acceptance/sim/.

  ID range: 100200-100229 (within the recommended 100000-120000
  custom-rule range, no overlap with 100100-100102 above).
-->

<!-- ============================================================
     SSH FAILED AUTHENTICATION
     Wazuh v4.9 rule 5760 is the concrete failed-password SSH rule:
       <if_sid>5700,5716</if_sid>
       <match>Failed password|Failed keyboard|authentication error</match>
     FAST promotes that base event to its own rule ID so Threat Hunting
     shows rule 100200 for the SSH failed-authentication detection.
     ============================================================ -->
<group name="local,ssh_brute_force,">
  <rule id="100200" level="10">
    <if_sid>5760</if_sid>
    <description>FAST SSH failed authentication detected from source IP ($(srcip)).</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>authentication_failures,ssh_brute_force,</group>
  </rule>
</group>

<!-- ============================================================
     NMAP PORT SCAN
     setup_prereqs.sh installs a narrow iptables mangle/PREROUTING
     LOG rule for only FAST's reserved test ports. Its prefix is
     FAST_PORTSCAN. PREROUTING is deliberately used so probes are
     logged before filter chains such as Tailscale/UFW can ACCEPT or
     DROP them. The normal Wazuh kernel/firewall decoder still parses
     SRC/DST/SPT/DPT and feeds rule 4100; FAST then keys specifically
     on its own prefix, avoiding unrelated firewall noise.
     ============================================================ -->
<group name="local,port_scan,">
  <rule id="100210" level="3">
    <if_sid>4100</if_sid>
    <match>FAST_PORTSCAN</match>
    <description>FAST port-scan probe observed from $(srcip) to port $(dstport)</description>
    <group>port_scan,recon,</group>
  </rule>
  <rule id="100211" level="7" frequency="8" timeframe="60">
    <if_matched_sid>100210</if_matched_sid>
    <same_source_ip />
    <description>FAST possible port scan: 8+ probes from the same source IP ($(srcip)) within 60 seconds.</description>
    <mitre>
      <id>T1046</id>
    </mitre>
    <group>port_scan,recon,</group>
  </rule>
</group>

<!-- ============================================================
     LOLBIN: wget MASQUERADING AS httpd
     Base: default Wazuh rule 80700 (audit base rule) -> 80792
     (audit "command execution" grouping rule). Confirmed decoded
     fields (0040-auditd_decoders.xml): audit.command (= auditd's
     "comm" field, the process name) and audit.exe (= auditd's
     "exe" field, the actual executed binary path).

     Detection logic (two signals, both required for the
     high-confidence alert):
       1) audit.command == "httpd" but audit.exe is NOT one of the
          standard Apache httpd install paths -> process is
          presenting itself as httpd from an unexpected location.
       2) The raw audit log line contains wget-style command-line
          evidence (a URL and/or wget output flags) that a real
          httpd process would never have on its command line.

     If your installed ruleset includes rule 92053 (an equivalent
     LOLBin/audit rule in some Wazuh ruleset versions), you can
     additionally chain off it by adding a second <if_sid>92053</if_sid>
     variant of rule 100221 - verify first with:
       grep -r 'id="92053"' /var/ossec/ruleset/rules/
     on the Wazuh Manager container.

     PREREQUISITE (target/agent host): auditd must be installed and
     configured to watch execve, and the agent must collect
     /var/log/audit/audit.log. See
     tests/acceptance/sim/setup_prereqs.sh.
     ============================================================ -->
<group name="local,lolbin,masquerading,">
  <rule id="100220" level="6">
    <if_sid>80792</if_sid>
    <field name="audit.command">^httpd$</field>
    <field name="audit.exe" negate="yes" type="pcre2">^/usr/sbin/httpd$|^/usr/local/apache2?/bin/httpd$|^/usr/sbin/apache2$</field>
    <description>Process presenting as "httpd" is running from a non-standard path ($(audit.exe)) - possible binary masquerading.</description>
    <mitre>
      <id>T1036.003</id>
    </mitre>
    <group>lolbin,masquerading,</group>
  </rule>
  <rule id="100221" level="12">
    <if_sid>100220</if_sid>
    <regex type="pcre2">https?://|--no-check-certificate|-{1,2}(O|output-document)\b</regex>
    <description>LOLBin confirmed: process masquerading as "httpd" ($(audit.exe)) is executing with wget-style arguments - likely wget renamed to evade process-name-based detection.</description>
    <mitre>
      <id>T1036.003</id>
      <id>T1105</id>
    </mitre>
    <group>lolbin,masquerading,ingress_tool_transfer,</group>
  </rule>
</group>
